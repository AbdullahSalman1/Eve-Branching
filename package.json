{
  "name": "env-branching",
  "version": "1.0.0",
  "description": "Simple Node.js + MongoDB CRUD app with staging, preprod and prod configs",
  "main": "src/app.js",
  "scripts": {
    "start:staging": "set NODE_ENV=staging&& node src/app.js",
    "start:preprod": "set NODE_ENV=preprod&& node src/app.js",
    "start:prod": "set NODE_ENV=prod&& node src/app.js"
  },
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongoose": "^9.12.3"
  }
}
